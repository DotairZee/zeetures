  enum 3 1 2
    setv var3 -1
    doif velx eq 0 and vely eq 0
      doif posl lt 6120 and post lt 850 setv var3 0 endi
      doif posl gt 6400 and posl lt 6520 and post gt 1200 setv var3 1 endi
      doif posl gt 7100 and post lt 860 setv var3 2 endi
    endi
    doif var3 eq ov00 and ov00 ne var0
      setv var2 ov00 addv var2 1 modv var2 3
      doif var2 eq var0
        mesg writ targ 0
      else
        mesg writ targ 1
      endi
    endi
  next
  wait 20 pose 0 setv actv 0
endm
scrp 2 2 225 2
